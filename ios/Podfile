platform :ios, '13.0'

# Flutter manages ALL Firebase pods automatically via flutter_install_all_ios_pods.
# Do NOT manually add Firebase/* pods here — it causes duplicate symbols at link time.

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      # Enforce iOS 13.0 minimum across ALL pods (prevents build warnings/errors)
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '13.0'
      # Disable deprecated bitcode (Apple dropped support in Xcode 14)
      config.build_settings['ENABLE_BITCODE'] = 'NO'
      # Fix for gRPC / BoringSSL linker warnings on arm64
      config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'i386 arm64'
    end
  end
end
