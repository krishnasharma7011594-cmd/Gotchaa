rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // --- PART 1: GLOBAL HELPER FUNCTIONS ---
    // ==========================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin'
      );
    }

    // ==========================================
    // --- PART 2: DATABASE COLLECTION RULES ---
    // ==========================================

    // Essential for app startup and profile filtering
    match /blocked_accounts/{blockId} {
      allow read, write: if isSignedIn();
    }
    match /muted_accounts/{muteId} {
      allow read, write: if isSignedIn();
    }
    match /rate_limits/{userId} {
      allow read, write: if isSignedIn();
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
      
      // Sub-collections like savedPosts
      match /{allSubcollections=**} {
        allow read, write: if isSignedIn();
      }
    }

    match /users_private/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    match /presence/{userId} {
      allow read, write: if isSignedIn();
    }

    match /usernames/{username} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn();
    }

    match /followers/{userId}/userFollowers/{followerId} {
      allow read, write: if isSignedIn();
    }

    match /following/{userId}/userFollowing/{followedId} {
      allow read, write: if isSignedIn();
    }

    match /chats/{chatId} {
      allow read, write: if isSignedIn();

      match /{allSubcollections=**} {
        allow read, write: if isSignedIn();
      }
    }

    match /posts/{postId} {
      allow read, write: if isSignedIn();
      match /{allSubcollections=**} {
        allow read, write: if isSignedIn();
      }
    }

    match /vybz/{vybzId} {
      allow read, write: if isSignedIn();
      match /{allSubcollections=**} {
        allow read, write: if isSignedIn();
      }
    }

    match /stories/{storyId} {
      allow read, write: if isSignedIn();
    }

    match /sounds/{soundId} {
      allow read: if isSignedIn() && (resource.data.visibility == 'public' || resource.data.creatorId == request.auth.uid);
      allow write: if false;
    }

    match /vibetalk_rooms/{roomId} {
      allow read, write: if isSignedIn();
      match /{document=**} {
        allow read, write: if isSignedIn();
      }
    }

    match /vibetalk_queue/{queueId} {
      allow read, write: if isSignedIn();
    }

    match /circles/{circleId} {
      allow read, write: if isSignedIn();
      match /{document=**} {
        allow read, write: if isSignedIn();
      }
    }

    match /circle_join_requests/{requestId} {
      allow read, write: if isSignedIn();
    }

    // ==========================================
    // --- PART 3: ZERO TRUST DENY ALL FALLBACK ---
    // ==========================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
