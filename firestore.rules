rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // --- PART 1: GLOBAL HELPER FUNCTIONS ---
    // ==========================================

    // Baseline authentication check
    function isSignedIn() {
      return request.auth != null;
    }

    // Baseline owner check
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Role elevation / Admin check
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin'
      );
    }

    // Moderator check
    function isModerator() {
      return isSignedIn() && (
        request.auth.token.moderator == true ||
        request.auth.token.role == 'moderator' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'moderator'
      );
    }

    // Data validation helpers

    function validateRequiredString(data, field, maxLen) {
      return data.get(field, null) != null && data.get(field, '') is string && data.get(field, '').size() <= maxLen;
    }

    function validateServerTimestamp(data, field) {
      return data.get(field, null) != null && data.get(field, null) == request.time;
    }

    // ==========================================
    // --- PART 2: DATABASE COLLECTION RULES ---
    // ==========================================

    // --- 1. USER PROFILES (users/{userId}) ---
    // Principle 3 & 4: Owner can update, but anyone can read public profiles.
    match /users/{userId} {
      allow read: if isSignedIn() &&
        !exists(/databases/$(database)/documents/blocked_accounts/$(request.auth.uid)_blocked_$(userId)) &&
        !exists(/databases/$(database)/documents/blocked_accounts/$(userId)_blocked_$(request.auth.uid));
      
      allow create: if isOwner(userId) && 
        request.resource.data.get('role', 'user') == 'user' && // No elevating role on create
        validateRequiredString(request.resource.data, 'displayName', 50) &&
        validateRequiredString(request.resource.data, 'username', 30);
        
      allow update: if isSignedIn() && (isOwner(userId) || isAdmin()) &&
        (isAdmin() || (
          request.resource.data.get('role', 'user') == resource.data.get('role', 'user') &&
          request.resource.data.get('isVerified', false) == resource.data.get('isVerified', false)
        ));

      allow delete: if isAdmin();
    }

    // --- 2. USER PRIVATE DATA (users_private/{userId}) ---
    // Principle 3: Only the owner (and admin) can access this.
    match /users_private/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();
    }

    // --- 3. PRESENCE (presence/{userId}) ---
    match /presence/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) && 
        validateRequiredString(request.resource.data, 'status', 20) &&
        validateServerTimestamp(request.resource.data, 'lastSeen');
    }

    // --- 4. USERNAME RESERVATIONS (usernames/{username}) ---
    match /usernames/{username} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && 
        request.resource.data.uid == request.auth.uid &&
        username is string && username.size() <= 30;
      allow update, delete: if isSignedIn() && 
        (resource == null || resource.data.uid == request.auth.uid);
    }

    // --- 5. SOCIAL GRAPH (Followers/Following) ---
    match /followers/{userId}/userFollowers/{followerId} {
      allow read, get, list: if isSignedIn();
      allow write: if isSignedIn() && followerId == request.auth.uid &&
        validateServerTimestamp(request.resource.data, 'timestamp') &&
        !exists(/databases/$(database)/documents/blocked_accounts/$(request.auth.uid)_blocked_$(userId)) &&
        !exists(/databases/$(database)/documents/blocked_accounts/$(userId)_blocked_$(request.auth.uid));
    }

    match /following/{userId}/userFollowing/{followedId} {
      allow read, get, list: if isSignedIn();
      allow write: if isSignedIn() && userId == request.auth.uid &&
        validateServerTimestamp(request.resource.data, 'timestamp') &&
        !exists(/databases/$(database)/documents/blocked_accounts/$(request.auth.uid)_blocked_$(followedId)) &&
        !exists(/databases/$(database)/documents/blocked_accounts/$(followedId)_blocked_$(request.auth.uid));
    }

    // --- 6. CHATS & MESSAGING (chats/{chatId}) ---
    // Principle 2: Chat privacy restricts access strictly to conversation participants.
    match /chats/{chatId} {
      // Participant-only read and update access.
      allow read: if isSignedIn() && (
        resource == null ||
        request.auth.uid in resource.data.get('participants', []) ||
        chatId.split('_').hasAny([request.auth.uid])
      );
      
      allow create: if isSignedIn() &&
        request.resource.data.get('participants', []) is list &&
        request.auth.uid in request.resource.data.get('participants', []);
        
      allow update: if isSignedIn() && 
        request.auth.uid in resource.data.get('participants', []) &&
        request.resource.data.get('participants', []) is list &&
        request.auth.uid in request.resource.data.get('participants', []);

      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isSignedIn() && (
          chatId.split('_').hasAny([request.auth.uid]) ||
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.get('participants', [])
        );
        
        allow create: if isSignedIn() && 
          request.resource.data.senderId == request.auth.uid &&
          validateRequiredString(request.resource.data, 'text', 1000) &&
          validateServerTimestamp(request.resource.data, 'timestamp') &&
          !exists(/databases/$(database)/documents/blocked_accounts/$(request.auth.uid)_blocked_$(request.resource.data.receiverId)) &&
          !exists(/databases/$(database)/documents/blocked_accounts/$(request.resource.data.receiverId)_blocked_$(request.auth.uid));
          
        allow update: if isSignedIn() && 
          (request.auth.uid == resource.data.senderId || request.auth.uid == resource.data.receiverId) &&
          (request.auth.uid == request.resource.data.senderId); // cannot spoof senderId
          
        allow delete: if isSignedIn() && request.auth.uid == resource.data.senderId;
      }

      // Typing Indicators
      // The document ID is the uid of the user typing.
      match /typing/{uid} {
        allow read: if isSignedIn() && chatId.split('_').hasAny([request.auth.uid]);
        allow write: if isSignedIn() && uid == request.auth.uid && chatId.split('_').hasAny([request.auth.uid]);
      }

      // Reactions
      // The uid here is the user who reacted, but reactions are inside messages. Wait, no.
      // In Gotchaa, reactions are a map inside the message document! The old rules had a /reactions subcollection.
      // If we still use a subcollection:
      match /reactions/{uid} {
        allow read: if isSignedIn() && chatId.split('_').hasAny([request.auth.uid]);
        allow write: if isSignedIn() && uid == request.auth.uid && chatId.split('_').hasAny([request.auth.uid]);
      }
    }

    // --- 7. SOCIAL POSTS (posts/{postId}) ---
    // Principle 3: Creating and deleting posts is restricted to the authorUid.
    match /posts/{postId} {
      allow read: if isSignedIn();
      
      allow create: if isSignedIn() && 
        request.resource.data.authorUid == request.auth.uid &&
        validateRequiredString(request.resource.data, 'text', 500) &&
        validateServerTimestamp(request.resource.data, 'createdAt');
        
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.authorUid || 
        // Allow other users to atomically increment stats
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'commentsCount'])
      );
      
      allow delete: if isSignedIn() && resource.data.authorUid == request.auth.uid;

      match /likes/{uid} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && request.auth.uid == uid &&
          validateServerTimestamp(request.resource.data, 'timestamp');
      }

      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && 
          request.resource.data.authorUid == request.auth.uid &&
          validateRequiredString(request.resource.data, 'text', 300) &&
          validateServerTimestamp(request.resource.data, 'createdAt');
        allow update, delete: if isSignedIn() && resource.data.authorUid == request.auth.uid;
        
        match /likes/{uid} {
          allow read: if isSignedIn();
          allow write: if isSignedIn() && request.auth.uid == uid &&
            validateServerTimestamp(request.resource.data, 'timestamp');
        }
      }
    }

    // --- 8. SHORT VIDEO CLIPS (vybz/{vybzId}) ---
    match /vybz/{vybzId} {
      allow read: if isSignedIn();
      
      allow create: if isSignedIn() && 
        request.resource.data.creatorId == request.auth.uid &&
        validateRequiredString(request.resource.data, 'videoUrl', 300) &&
        validateServerTimestamp(request.resource.data, 'createdAt');
        
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.creatorId ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'commentsCount'])
      );
      
      allow delete: if isSignedIn() && resource.data.creatorId == request.auth.uid;

      match /likes/{uid} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && request.auth.uid == uid &&
          validateServerTimestamp(request.resource.data, 'timestamp');
      }
      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && 
          request.resource.data.authorUid == request.auth.uid &&
          validateRequiredString(request.resource.data, 'text', 300) &&
          validateServerTimestamp(request.resource.data, 'createdAt');
        allow update, delete: if isSignedIn() && resource.data.authorUid == request.auth.uid;
        
        match /likes/{uid} {
          allow read: if isSignedIn();
          allow write: if isSignedIn() && request.auth.uid == uid &&
            validateServerTimestamp(request.resource.data, 'timestamp');
        }
      }
    }

    // --- 9. STORIES (stories/{storyId}) ---
    match /stories/{storyId} {
      allow read: if isSignedIn();
      
      allow create: if isSignedIn() && 
        request.resource.data.authorUid == request.auth.uid &&
        validateRequiredString(request.resource.data, 'mediaUrl', 300) &&
        validateServerTimestamp(request.resource.data, 'createdAt');
        
      allow update: if isSignedIn() && resource.data.authorUid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.authorUid == request.auth.uid;
    }

    // --- 10. SYSTEM & ADMIN LOGS ---
    match /deletionLog/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isAdmin();
    }

    match /notifications/{userId}/userNotifications/{notifId} {
      allow read: if isOwner(userId) || isAdmin();
      
      allow create: if isSignedIn() && 
        request.resource.data.fromUid == request.auth.uid &&
        validateRequiredString(request.resource.data, 'text', 200) &&
        validateServerTimestamp(request.resource.data, 'timestamp');
        
      allow update, delete: if isOwner(userId) || isAdmin();
    }

    match /grievances/{id} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid &&
        validateServerTimestamp(request.resource.data, 'createdAt');
      allow update, delete: if isAdmin();
    }

    match /moderation_reports/{reportId} {
      allow read: if isSignedIn() && (resource.data.reportedByUserId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.reportedByUserId == request.auth.uid &&
        validateServerTimestamp(request.resource.data, 'timestamp');
      allow update, delete: if isAdmin();
    }

    match /flagged_content/{id} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if isAdmin(); 
    }

    match /takedown_requests/{id} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid &&
        validateServerTimestamp(request.resource.data, 'timestamp');
      allow update, delete: if isAdmin();
    }

    // --- 11. VIBETALK MATCHMAKING ---
    match /vibetalk_queue/{queueId} {
      allow read: if isSignedIn() && (queueId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && queueId == request.auth.uid && 
        request.resource.data.uid == request.auth.uid &&
        validateServerTimestamp(request.resource.data, 'timestamp');
      allow update: if isAdmin();
      allow delete: if isSignedIn() && (queueId == request.auth.uid || isAdmin());
    }

    match /vibetalk_rooms/{roomId} {
      allow read: if isSignedIn() && (resource == null || request.auth.uid in resource.data.get('users', []));
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.get('users', []) &&
        validateServerTimestamp(request.resource.data, 'createdAt');
      allow update, delete: if isSignedIn() && request.auth.uid in resource.data.get('users', []);
      
      match /{document=**} {
        allow read, write: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/vibetalk_rooms/$(roomId)).data.get('users', []);
      }
    }

    // --- 12. AGGREGATED TRENDS ---
    match /trending/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // --- 13. LEGACY / UTILITY COLLECTIONS ---
    match /invite_codes/{code} { 
      allow read: if isSignedIn(); 
      allow write: if isAdmin(); 
    }
    match /invite_code_index/{code} { 
      allow read: if isSignedIn(); 
      allow write: if isAdmin(); 
    }
    match /inviteAnalytics/{code} { 
      allow read: if isSignedIn(); 
      allow write: if isSignedIn(); 
    }
    match /inviteRequests/{reqId} {
      allow read: if isAdmin() || isOwner(reqId);
      allow write: if isAdmin() || isOwner(reqId);
    }
    match /rate_limits/{userId} { 
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();
    }

    // --- 14. CIRCLES MINI-APP ---
    


    match /circles/{circleId} {
      allow read: if isSignedIn();
      
      // Creating a circle: hostId must match auth.uid, memberIds must start with hostId in it.
      allow create: if isSignedIn() &&
        request.resource.data.get('hostId', '') == request.auth.uid &&
        request.resource.data.get('isActive', true) == true &&
        request.auth.uid in request.resource.data.get('memberIds', []) &&
        validateRequiredString(request.resource.data, 'title', 100) &&
        validateRequiredString(request.resource.data, 'city', 100);
      
      // Updating a circle: 
      // Only host can update configuration fields (title, category, memberLimit, isApprovalRequired, isActive, etc.)
      // Any member can join/leave (which updates memberIds array).
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.get('hostId', '') ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
      );

      allow delete: if isSignedIn() && (request.auth.uid == resource.data.get('hostId', '') || isAdmin());

      // Chat Messages in a circle
      match /messages/{messageId} {
        // Only members of the circle can read or write chat messages.
        allow read: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/circles/$(circleId)).data.get('memberIds', []);
        
        allow create: if isSignedIn() && 
          request.auth.uid in get(/databases/$(database)/documents/circles/$(circleId)).data.get('memberIds', []) &&
          request.resource.data.senderId == request.auth.uid &&
          validateRequiredString(request.resource.data, 'text', 1000) &&
          validateServerTimestamp(request.resource.data, 'timestamp');
          
        allow update, delete: if isSignedIn() && 
          (request.auth.uid == resource.data.senderId || request.auth.uid == get(/databases/$(database)/documents/circles/$(circleId)).data.get('hostId', ''));
      }

      // Check-ins in a circle
      match /checkins/{userId} {
        // Anyone in the circle can read check-ins (so radar knows who is checked-in)
        allow read: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/circles/$(circleId)).data.get('memberIds', []);
        
        // Only the specific user can write/create their own check-in doc, must be a member, no overwrites/updates
        allow create: if isSignedIn() && 
          request.auth.uid == userId && 
          request.auth.uid in get(/databases/$(database)/documents/circles/$(circleId)).data.get('memberIds', []) &&
          validateServerTimestamp(request.resource.data, 'timestamp');
        
        allow update, delete: if isAdmin() || (isSignedIn() && request.auth.uid == get(/databases/$(database)/documents/circles/$(circleId)).data.get('hostId', ''));
      }

      // Live location updates
      match /liveLocations/{userId} {
        // Only users who have checked in to this circle can read or write live locations
        allow read, write: if isSignedIn() && 
          exists(/databases/$(database)/documents/circles/$(circleId)/checkins/$(request.auth.uid)) &&
          (request.method == 'get' || request.method == 'list' || request.auth.uid == userId);
      }
    }

    // Join requests
    match /circle_join_requests/{requestId} {
      allow read: if isSignedIn() && (
        resource == null ||
        request.auth.uid == resource.data.get('userId', '') ||
        request.auth.uid == get(/databases/$(database)/documents/circles/$(resource.data.get('circleId', ''))).data.get('hostId', '')
      );
      
      allow create: if isSignedIn() &&
        request.resource.data.get('userId', '') == request.auth.uid &&
        validateServerTimestamp(request.resource.data, 'timestamp');
        
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.get('userId', '') ||
        request.auth.uid == get(/databases/$(database)/documents/circles/$(resource.data.get('circleId', ''))).data.get('hostId', '')
      );
      
      allow delete: if isSignedIn() && (
        request.auth.uid == resource.data.get('userId', '') ||
        request.auth.uid == get(/databases/$(database)/documents/circles/$(resource.data.get('circleId', ''))).data.get('hostId', '') ||
        isAdmin()
      );
    }

    // Users Circles profile subcollection
    match /users/{userId}/circles_profile/{docId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) || isAdmin();
    }

    // --- 15. UGC BLOCKS, MUTING & MODERATION QUEUE ---
    match /blocked_accounts/{blockId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && 
        request.auth.uid == request.resource.data.blockerId && 
        blockId == request.resource.data.blockerId + "_blocked_" + request.resource.data.blockedId;
      allow delete: if isSignedIn() && (request.auth.uid == resource.data.blockerId || isAdmin());
    }

    match /muted_accounts/{muteId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && 
        request.auth.uid == request.resource.data.muterId && 
        muteId == request.resource.data.muterId + "_muted_" + request.resource.data.mutedId;
      allow delete: if isSignedIn() && (request.auth.uid == resource.data.muterId || isAdmin());
    }

    match /moderation_queue/{itemId} {
      allow read, write: if isModerator() || isAdmin();
    }

    // ==========================================
    // --- PART 3: ZERO TRUST DENY ALL FALLBACK ---
    // ==========================================
    // Principle 1: Every rule must deny by default.

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
