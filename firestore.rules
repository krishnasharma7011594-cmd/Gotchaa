rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // --- PART 1: GLOBAL HELPER FUNCTIONS ---
    // ==========================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // SECURITY: Admin/moderator role is verified ONLY via Firebase custom claims
    // set server-side by Admin SDK. The `role` field on the user doc is NOT
    // authoritative for admin checks. This prevents the VULN-001 privilege
    // escalation where a user could write role:'admin' to their own doc.
    function isAdmin() {
      return isSignedIn() && request.auth.token.role == 'admin';
    }

    function isModerator() {
      return isSignedIn() && (
        request.auth.token.role == 'admin' ||
        request.auth.token.role == 'moderator'
      );
    }

    // Fields that only the Admin SDK (server-side) may write.
    // Client writes that try to set these fields are rejected.
    function isNotWritingRestrictedUserFields() {
      return !(request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['role', 'isBanned', 'isSuspended', 'suspensionReason',
                 'ageTier', 'ageVerified', 'karmaScore', 'isVerified',
                 'verificationStatus']));
    }

    // ==========================================
    // --- PART 2: DATABASE COLLECTION RULES ---
    // ==========================================

    // Essential for app startup and profile filtering
    match /blocked_accounts/{blockId} {
      allow read, write: if isSignedIn();
    }
    match /muted_accounts/{muteId} {
      allow read, write: if isSignedIn();
    }

    // SECURITY FIX (VULN-001): rate_limits are server-managed only.
    // Clients can read their own doc but may not write (prevents limit bypass).
    match /rate_limits/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // SECURITY FIX (VULN-001):
    // - Users can only create/update their OWN profile document.
    // - Writes that touch restricted server-only fields (role, isBanned, etc.)
    //   are rejected — those fields are Admin SDK-only.
    match /users/{userId} {
      allow read: if isSignedIn();

      allow create: if isOwner(userId)
                    && !request.resource.data.keys().hasAny([
                         'role', 'isBanned', 'isSuspended', 'suspensionReason',
                         'ageTier', 'ageVerified', 'karmaScore', 'isVerified',
                         'verificationStatus'
                       ]);

      allow update: if isOwner(userId)
                    && isNotWritingRestrictedUserFields();

      allow delete: if isAdmin();

      // Analytics sub-collection: only owner or admin can read/write
      match /analytics/{docId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if false; // Written only by Cloud Functions (Admin SDK)
      }

      // vibetalkLimits sub-collection: server-managed rate limits
      match /vibetalkLimits/{docId} {
        allow read: if isOwner(userId);
        allow write: if false; // Written only by Cloud Functions (Admin SDK)
      }

      // sessions sub-collection: owner only
      match /sessions/{sessionId} {
        allow read, write: if isOwner(userId);
      }

      // savedPosts and other user sub-collections: owner only
      match /savedPosts/{postId} {
        allow read, write: if isOwner(userId);
      }

      // Catch-all for any other sub-collections under users/{userId}:
      // restrict to owner (not open to all authenticated users as before)
      match /{subDoc=**} {
        allow read, write: if isOwner(userId);
      }
    }

    match /users_private/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    match /presence/{userId} {
      allow read, write: if isSignedIn();
    }

    match /usernames/{username} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      // Only the owner can update/delete their own username reservation
      allow update, delete: if isSignedIn() &&
        resource.data.get('uid', '') == request.auth.uid;
    }

    // Only followers/following involved can write or read
    match /followers/{userId}/userFollowers/{followerId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(followerId);
      allow delete: if isOwner(userId) || isOwner(followerId) || isAdmin();
    }

    match /following/{userId}/userFollowing/{followedId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId);
      allow delete: if isOwner(userId) || isOwner(followedId) || isAdmin();
    }

    // SECURITY FIX (VULN-003): Chat collection participant verification
    match /chats/{chatId} {
      // Direct message chat IDs are format: uid1_uid2. Verify the user is either uid1 or uid2.
      function isChatParticipant() {
        return isSignedIn() && (
          chatId.split('_')[0] == request.auth.uid ||
          chatId.split('_')[1] == request.auth.uid
        );
      }

      allow read, write: if isChatParticipant() || isAdmin();

      match /{allSubcollections=**} {
        allow read, write: if isChatParticipant() || isAdmin();
      }
    }

    // SECURITY FIX (VULN-003): Post writes restricted to owner
    match /posts/{postId} {
      allow read: if isSignedIn();
      // Only owner can create or update/delete post.
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());

      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
        allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      }

      match /likes/{userId} {
        allow read: if isSignedIn();
        allow write: if isOwner(userId);
      }

      match /{allSubcollections=**} {
        allow read: if isSignedIn();
        allow write: if isSignedIn();
      }
    }

    // SECURITY FIX (VULN-003): Vybz (video reels) write verification
    match /vybz/{vybzId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      
      match /{allSubcollections=**} {
        allow read: if isSignedIn();
        allow write: if isSignedIn();
      }
    }

    // SECURITY FIX (VULN-003): Stories owner controls
    match /stories/{storyId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /sounds/{soundId} {
      allow read: if isSignedIn() && (resource.data.visibility == 'public' || resource.data.creatorId == request.auth.uid);
      allow write: if false;
    }

    // SECURITY FIX (VULN-003): Vibetalk Rooms participant rules
    match /vibetalk_rooms/{roomId} {
      function isRoomParticipant() {
        return isSignedIn() && (
          resource.data.callerId == request.auth.uid ||
          resource.data.calleeId == request.auth.uid
        );
      }
      allow read: if isRoomParticipant() || isAdmin();
      // Allow creation by matching function transaction. Allow updates for gamestate only.
      allow create: if isAdmin();
      allow update: if isRoomParticipant() || isAdmin();
      allow delete: if isAdmin();

      match /{document=**} {
        allow read, write: if isRoomParticipant() || isAdmin();
      }
    }

    // Vibetalk matching queue
    match /vibetalk_queue/{queueId} {
      allow read: if isOwner(queueId) || isAdmin();
      allow write: if isOwner(queueId);
    }

    // SECURITY FIX (VULN-003): Circles (groups) admin/member restrictions
    match /circles/{circleId} {
      function isCircleMember() {
        return isSignedIn() && (
          request.auth.uid in resource.data.members ||
          resource.data.ownerId == request.auth.uid
        );
      }
      allow read: if isCircleMember() || resource.data.visibility == 'public';
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isCircleMember());
      allow delete: if isSignedIn() && (resource.data.ownerId == request.auth.uid || isAdmin());

      match /{document=**} {
        allow read, write: if isCircleMember() || isAdmin();
      }
    }

    match /circle_join_requests/{requestId} {
      allow read, write: if isSignedIn();
    }

    // Notifications: users can only read their own notifications
    match /notifications/{userId}/userNotifications/{notifId} {
      allow read: if isOwner(userId);
      allow write: if false; // Written only by Cloud Functions
    }

    // Moderation collections: ONLY accessible by admin/moderator roles
    // (verified via custom claims set server-side, NOT the user doc's role field)
    match /moderation_reports/{reportId} {
      allow read, write: if isModerator();
    }

    match /moderation_actions/{actionId} {
      allow read: if isModerator();
      allow write: if false; // Written only by Cloud Functions (Admin SDK)
    }

    match /csam_incidents/{incidentId} {
      allow read, write: if isAdmin();
    }

    // music_generation_limits: server-written only
    match /music_generation_limits/{docId} {
      allow read: if isOwner(docId.split('_')[0]);
      allow write: if false;
    }

    // login_attempts: server-written only
    match /login_attempts/{docId} {
      allow read, write: if false;
    }

    // parental_consents: owner can read, server writes
    match /parental_consents/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false; // Written only by Cloud Functions
    }

    // trending: public read
    match /trending/{docId} {
      allow read: if isSignedIn();
      allow write: if false; // Written only by Cloud Functions
    }

    // bro_failures: admin only
    match /bro_failures/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ==========================================
    // --- PART 3: ZERO TRUST DENY ALL FALLBACK ---
    // ==========================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
