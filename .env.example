# Gotchaa - Environment Variables Example
# 
# Copy this file to .env and fill in your actual keys.
# DO NOT commit the .env file to version control.

# --- AI APIs ---
# Gemini API Key (Required for BRO AI functionality)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API Key (Required for ultra-fast text inference)
GROQ_API_KEY=your_groq_api_key_here


# --- Firebase Backend ---
# Required for connecting the Node.js backend to Firebase
FIREBASE_PROJECT_ID=studio-1284397718-50704
FIREBASE_STORAGE_BUCKET=studio-1284397718-50704.firebasestorage.app


# --- Third Party Integrations ---
# Spotify Client Credentials (Required for music search)
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here


# --- Security ---
# Allowed origins for CORS (comma separated list of URLs)
# If omitted, defaults to local development URLs + production Firebase web app URLs.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
